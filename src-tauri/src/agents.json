[
  {
    "name": "Claude Code",
    "note": "2.1.287, native (argv[0] \"claude\"). ~/.claude/sessions/<pid>.json holds sessionId and status (busy|shell|waiting|idle), rewritten as they change. An npm install runs `node …/cli.js` and sets process.title, which overwrites its argv: its flags read as empty and aren't kept.",
    "programs": ["claude"],
    "scripts": ["@anthropic-ai/claude-code/cli.js"],
    "session": {
      "kind": "pidFile",
      "path": "~/.claude/sessions/{pid}.json",
      "id": "sessionId",
      "uuid": true,
      "status": { "field": "status", "working": ["busy", "shell"], "waiting": ["waiting"], "idle": ["idle"] }
    },
    "resume": ["claude", "--resume", "{id}", "{flags}"],
    "flags": {
      "--agent": "1",
      "--agents": "1",
      "--append-system-prompt": "1",
      "--append-system-prompt-file": "1",
      "--autocompact": "1",
      "--debug-file": "1",
      "--effort": "1",
      "--environment": "1",
      "--fallback-model": "1",
      "--input-format": "1",
      "--json-schema": "1",
      "--max-budget-usd": "1",
      "--model": "1",
      "-n": "1",
      "--name": "1",
      "--output-format": "1",
      "--permission-mode": "1",
      "--permission-prompts": "1",
      "--plugin-dir": "1",
      "--plugin-url": "1",
      "--remote-control-session-name-prefix": "1",
      "--session-id": "1",
      "--setting-sources": "1",
      "--settings": "1",
      "--system-prompt": "1",
      "--system-prompt-file": "1",
      "--system-prompt-snapshot": "1",
      "--cloud": "?",
      "-d": "?",
      "--debug": "?",
      "--from-pr": "?",
      "--prompt-suggestions": "?",
      "-r": "?",
      "--remote-control": "?",
      "--resume": "?",
      "--teleport": "?",
      "-w": "?",
      "--worktree": "?",
      "--add-dir": "*",
      "--allowedTools": "*",
      "--allowed-tools": "*",
      "--betas": "*",
      "--disallowedTools": "*",
      "--disallowed-tools": "*",
      "--file": "*",
      "--mcp-config": "*",
      "--tools": "*"
    },
    "drop": ["-c", "--continue", "-r", "--resume", "--session-id", "--fork-session", "--from-pr", "--teleport", "--cloud", "-n", "--name", "-w", "--worktree", "--tmux"],
    "skip": [
      "-p", "--print", "--bg", "--background", "--desktop", "-h", "--help", "-v", "--version",
      "agents", "attach", "auth", "auto-mode", "doctor", "gateway", "import", "install", "kill", "logs", "mcp",
      "plugin", "plugins", "project", "respawn", "rm", "setup-token", "stop", "ultrareview", "update", "upgrade"
    ]
  },
  {
    "name": "Gemini CLI",
    "note": "0.27, `node …/bin/gemini`, relaunched as a child in the same job. A chat is ~/.gemini/tmp/<sha256 of its folder>/chats/session-<time>-<id8>.json; a resumed one is written to again, so the newest written since the start is this run's (two runs in one folder can't be told apart).",
    "programs": ["gemini"],
    "scripts": ["@google/gemini-cli/dist/index.js"],
    "session": {
      "kind": "newestFile",
      "dir": "~/.gemini/tmp/{cwdSha256}/chats",
      "prefix": "session-",
      "id": "sessionId",
      "uuid": true
    },
    "resume": ["gemini", "--resume", "{id}", "{flags}"],
    "flags": {
      "--approval-mode": "1",
      "--delete-session": "1",
      "-e": "1",
      "--extensions": "1",
      "-i": "1",
      "-m": "1",
      "--model": "1",
      "-o": "1",
      "--output-format": "1",
      "-p": "1",
      "--prompt": "1",
      "--prompt-interactive": "1",
      "-r": "?",
      "--resume": "?",
      "--allowed-mcp-server-names": "*",
      "--allowed-tools": "*",
      "--include-directories": "*"
    },
    "drop": ["-r", "--resume", "-i", "--prompt-interactive"],
    "skip": [
      "-p", "--prompt", "--experimental-acp", "-l", "--list-extensions", "--list-sessions", "--delete-session", "-h", "--help", "-v", "--version",
      "mcp", "extensions", "extension", "skills", "skill", "hooks", "hook"
    ]
  },
  {
    "name": "opencode",
    "note": "1.x, a native binary. Its sessions are in SQLite, so the folder's last one is continued rather than read: another run in the folder since makes that one the last.",
    "programs": ["opencode"],
    "session": { "kind": "continue" },
    "resume": ["opencode", "{flags}", "--continue"],
    "flags": {
      "--agent": "1",
      "--hostname": "1",
      "--log-level": "1",
      "-m": "1",
      "--mdns-domain": "1",
      "--model": "1",
      "--port": "1",
      "--prompt": "1",
      "--replay-limit": "1",
      "-s": "1",
      "--session": "1",
      "--cors": "*"
    },
    "drop": ["-c", "--continue", "-s", "--session", "--fork", "--prompt"],
    "skip": [
      "-h", "--help", "-v", "--version",
      "acp", "agent", "attach", "auth", "completion", "db", "debug", "export", "github", "import", "mcp", "models",
      "plug", "plugin", "pr", "providers", "run", "serve", "session", "stats", "uninstall", "upgrade", "web"
    ]
  },
  {
    "name": "Codex",
    "note": "UNVERIFIED: not installed where this was written. From its docs: `codex resume --last` continues the folder's last session; `exec` runs without one. npm's launcher is `node …/bin/codex.js`.",
    "programs": ["codex"],
    "scripts": ["@openai/codex/bin/codex.js"],
    "session": { "kind": "continue" },
    "resume": ["codex", "resume", "--last", "{flags}"],
    "flags": {
      "-a": "1",
      "--ask-for-approval": "1",
      "-c": "1",
      "--config": "1",
      "-C": "1",
      "--cd": "1",
      "-m": "1",
      "--model": "1",
      "-p": "1",
      "--profile": "1",
      "-s": "1",
      "--sandbox": "1",
      "-i": "*",
      "--image": "*"
    },
    "drop": ["--last", "-i", "--image"],
    "skip": [
      "-h", "--help", "-V", "--version",
      "apply", "a", "app-server", "cloud", "completion", "debug", "e", "exec", "login", "logout", "mcp", "mcp-server", "sandbox"
    ]
  }
]

#!/bin/sh
# `gitviber [path ...]`: hands each path to GitViber, which opens the repository of the last
# one; the current folder by default. A file opens in the code view, at `file:line[:column]`.
# GitViber → Install 'gitviber' Command links it onto PATH (cli.rs). `open -b` finds the app by
# its bundle id wherever it's installed, and hands a running app the path; `--` keeps a path
# starting with "-" from reading as an option.
case $1 in
browser)
  # `gitviber browser <command>`: this terminal pane's browser tab, for an agent (browser/client.rs).
  shift
  if [ -z "$GITVIBER_EXE" ]; then
    echo "gitviber browser works in GitViber's own terminals." >&2
    exit 2
  fi
  exec "$GITVIBER_EXE" --browser "$@"
  ;;
esac
[ $# -eq 0 ] && set -- .
for path in "$@"; do
  if [ ! -e "$path" ]; then
    # `open` carries only paths that exist: one that doesn't (`a.ts:12`) goes in a request file,
    # which GitViber reads and deletes (opened.rs). In /tmp, not $TMPDIR: a shell can set that
    # to a folder the app doesn't look in.
    case $path in /*) ;; *) path=$PWD/$path ;; esac
    request=$(mktemp /tmp/gitviber-open.XXXXXX) || exit
    printf '%s\n' "$path" >"$request"
    path=$request
  fi
  open -b app.gitviber.desktop -- "$path" || { [ -n "$request" ] && rm -f "$request"; exit 1; }
  request=
done
